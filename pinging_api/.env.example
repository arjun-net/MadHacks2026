# ── Campus Pulse live pinging worker ─────────────────────────────
# Loaded automatically by the sender (dotenvy). CLI flags override these.

# FastAPI ingest base URL (no trailing slash)
PULSE_TARGET=http://127.0.0.1:8000

# Ingest endpoint path on the target
PULSE_PATH=/ingest

# Input CSV (lat,long,timestamp,building) — absolute or relative to the
# pinging_api/ directory
PULSE_CSV=data/campus_simulation_apicalls.csv

# Wall-clock milliseconds per tick (one CSV timestamp per tick; the data is
# 2 sim-minutes apart, so 2000 = real-time replay)
PULSE_TICK_MS=2000

# Max random per-device POST stagger in ms (0..jitter) for realism
PULSE_JITTER_MS=40

# Max concurrent in-flight POSTs (burst limiter)
PULSE_CONCURRENCY=200

# Post only the first N rows per tick (unset = all rows in the tick)
#PULSE_DEVICES=100

# Start at this tick index (unset = 0)
#PULSE_START_TICK=0

# Exit after one full pass of the CSV instead of looping forever (true/false)
#PULSE_ONCE=true
