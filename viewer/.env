# viewer/serve.py — where the /api/v1 proxy points.
# This is the web dashboard's own config, separate from pinging_api/.env
# (the pinging service has its own PULSE_TARGET there).
#
# Override without editing this file:
#   python3 viewer/serve.py --api https://<tunnel>.trycloudflare.com/api/v1
# or: CAMPUS_API_BASE=... python3 viewer/serve.py
CAMPUS_API_BASE=https://transparent-hitachi-marion-marie.trycloudflare.com/api/v1
